#!/usr/bin/env sh
set -eu

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

block_pattern='^(\.txn/|build\.log$)'
blocked="$(printf '%s\n' "$staged" | grep -E "$block_pattern" || true)"
if [ -n "$blocked" ]; then
  echo "[pre-commit] blocked: temporary artifacts are staged (.txn/, build.log)." >&2
  echo "[pre-commit] matched staged paths:" >&2
  printf '%s\n' "$blocked" >&2
  echo "[pre-commit] run the following to unstage:" >&2
  printf '%s\n' "$blocked" | sed 's#^#git restore --staged -- #' >&2
  exit 1
fi

# Reject commit when any submodule worktree is dirty.
if git submodule status --recursive 2>/dev/null | grep -E '[-]dirty' >/dev/null 2>&1; then
  echo "[pre-commit] blocked: dirty submodule detected (-dirty)." >&2
  echo "Please commit/clean submodule changes first." >&2
  exit 1
fi

# 生成物只能与其源同批提交：skills.ps1 / skills.lib 或 rules/global/<host>/ 变更时，
# 必须同时带上 src/、build.ps1 或 rules/global 源文件；CI -CheckGenerated 仍是最终裁决。
generated_changed="$(printf '%s\n' "$staged" | grep -E '^(skills\.ps1$|skills\.lib/|rules/global/(claude|codex|zcode|antigravity|workbuddy)/)' || true)"
source_changed="$(printf '%s\n' "$staged" | grep -E '^(src/|build\.ps1$|rules/global/common\.md$|rules/global/platforms/)' || true)"
if [ -n "$generated_changed" ] && [ -z "$source_changed" ]; then
  echo "[pre-commit] blocked: generated files staged without their sources (src/, build.ps1, rules/global/common.md, rules/global/platforms/)." >&2
  printf '%s\n' "$generated_changed" >&2
  exit 1
fi

exit 0
