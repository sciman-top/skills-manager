# build/cache
/vendor/
/imports/
/agent/
/reports/*.log
/reports/
/docs/runtime-*.txt
/artifacts/*
!/artifacts/README.md
# Keep category README anchors tracked while all generated children stay local.
!/artifacts/deliveries/
!/artifacts/deliveries/README.md
!/artifacts/deliveries/release/
!/artifacts/deliveries/migration/
!/artifacts/deliveries/release/README.md
!/artifacts/deliveries/migration/README.md
/artifacts/deliveries/release/*
/artifacts/deliveries/migration/*
!/artifacts/deliveries/release/README.md
!/artifacts/deliveries/migration/README.md
# Version roots are local staging only. Keep the deliveries README tracked,
# but never allow generated public ZIPs or private snapshots into Git.
!/artifacts/deliveries/*/
/artifacts/deliveries/*/*
!/artifacts/history/
!/artifacts/history/README.md
!/artifacts/history/*/
/artifacts/history/*/*
!/artifacts/work/
!/artifacts/work/README.md
!/artifacts/work/*/
/artifacts/work/*/*
/migration-*.zip

# backups created when linking
**/*.bak.*

# OS
.DS_Store
Thumbs.db
.txn/
build.log
build.log.*
acl-backup-git-*.txt

# local agent / IDE state
/.claude/
/.codex/
/.gemini/
/.trae/
/imports/**/.venv/
/imports/**/nohup.out
/imports/**/.skills-manager-source.json
/.gitmessage.txt
/.tmp_*

# temporary import diagnostics
/imports/_debug_*/
/imports/_archive_*/
/imports/_probe_*/
/imports/_tree_*/
/imports/*.zip

# ad hoc governance outputs
/scripts/governance/

# Git worktrees (local fallback)
.worktrees/
worktrees/

