# build/cache
/vendor/
/imports/
/agent/
/reports/*.log
/reports/
/audit-targets.local.json
/docs/runtime-*.txt
/artifacts/*
!/artifacts/README.md
# Keep the deliveries root README tracked while all generated version trees stay local.
!/artifacts/deliveries/
!/artifacts/deliveries/README.md
# Version roots are local staging only. Keep the deliveries README tracked,
# but never allow generated public ZIPs or private snapshots into Git.
/artifacts/deliveries/*/
/artifacts/deliveries/*/*
!/artifacts/history/
!/artifacts/history/README.md
!/artifacts/history/*/
/artifacts/history/*/*
!/artifacts/work/
# work 根层散文件（并发会话运行日志、临时产物）全部本地化：漏网会使
# untracked 集永不为空，宿主投影的 clean 门槛被永久卡死。
/artifacts/work/*
!/artifacts/work/README.md
!/artifacts/work/*/
/artifacts/work/*/*
/migration-*.zip

# backups created when linking
**/*.bak.*

# OS
.DS_Store
Thumbs.db
.txn/
build.log
build.log.*
acl-backup-git-*.txt

# local agent / IDE state
/.claude/
/.codex/
/.gemini/
/.trae/
/.workbuddy-ai/
/.zcode/
/imports/**/.venv/
/imports/**/nohup.out
/imports/**/.skills-manager-source.json
/.gitmessage.txt
/.tmp_*

# temporary import diagnostics
/imports/_debug_*/
/imports/_archive_*/
/imports/_probe_*/
/imports/_tree_*/
/imports/*.zip

# ad hoc governance outputs
/scripts/governance/

# Git worktrees (local fallback)
.worktrees/
worktrees/

