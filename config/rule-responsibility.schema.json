{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schemas/rule-responsibility-v1.json",
  "type": "object",
  "required": ["schema_version", "constraint_id", "common_intent", "platform_deltas", "project_actions", "enforcement_refs", "coverage", "evidence", "confidence", "recovery_condition"],
  "properties": {
    "schema_version": {"const": 1}, "constraint_id": {"type": "string", "minLength": 1}, "common_intent": {"type": "string", "minLength": 1},
    "platform_deltas": {"type": "array"}, "project_actions": {"type": "array"}, "enforcement_refs": {"type": "array"},
    "coverage": {"enum": ["covered", "gap", "conflict", "duplicated", "not_applicable"]}, "evidence": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "recovery_condition": {"type": ["string", "null"]}
  }
}
