{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schemas/rule-document-v1.json",
  "type": "object",
  "required": ["schema_version", "id", "host", "scope", "responsibility", "path", "owner", "content_hash", "byte_size", "precedence", "discovery_state", "source_of_truth", "findings", "evidence", "verification_state"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"pattern": "^rule-[a-f0-9]{16}$"}, "host": {"type": "string", "minLength": 1},
    "scope": {"enum": ["global", "repo", "subtree", "override"]},
    "responsibility": {"enum": ["common", "platform_delta", "project_action", "deterministic_enforcement", "task_local"]},
    "path": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "content_hash": {"type": ["string", "null"]},
    "byte_size": {"type": "integer", "minimum": 0}, "precedence": {"type": ["integer", "null"]},
    "discovery_state": {"enum": ["observed", "inferred", "unknown"]}, "source_of_truth": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "evidence": {"type": "array"},
    "verification_state": {"enum": ["not_verified", "static_validated", "repo_verified", "host_loaded", "live_accepted"]}
  },
  "$defs": {"finding": {"type": "object", "required": ["finding_id", "kind", "code", "severity", "path", "message", "evidence", "confidence", "disposition", "blocking"], "properties": {"finding_id": {"type": "string"}, "kind": {"enum": ["deterministic", "semantic"]}, "code": {"type": "string"}, "severity": {"enum": ["info", "warning", "error"]}, "path": {"type": "string"}, "line": {"type": ["integer", "null"]}, "message": {"type": "string"}, "evidence": {"type": "array"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "disposition": {"enum": ["adopt", "adapt", "reject", "defer"]}, "blocking": {"type": "boolean"}}}}
}
