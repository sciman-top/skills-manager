{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schemas/capability-descriptor-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "name", "truth_origin", "source", "lifecycle", "host_compatibility", "components", "evidence", "verification_state"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"pattern": "^cap-[a-f0-9]{16}$"},
    "kind": {"enum": ["skill", "plugin", "mcp"]}, "name": {"type": "string", "minLength": 1},
    "truth_origin": {"enum": ["runtime", "reference", "official", "host_installed", "candidate"]},
    "source": {"type": "object", "required": ["type", "path_or_url", "revision", "checksum", "license", "trust_tier"], "properties": {"type": {"type": "string", "minLength": 1}, "path_or_url": {"type": "string", "minLength": 1}, "revision": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "trust_tier": {"type": ["string", "null"]}}},
    "lifecycle": {"enum": ["active", "deprecated", "historical", "unknown"]},
    "host_compatibility": {"type": "array"}, "components": {"type": "array"}, "evidence": {"type": "array"},
    "verification_state": {"enum": ["not_verified", "static_validated", "repo_verified", "host_loaded", "live_accepted"]}
  }
}
