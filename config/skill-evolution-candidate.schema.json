{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/skill-evolution-candidate.v1.json",
  "title": "SkillEvolution isolated candidate manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "candidate_id", "skill_name", "candidate_mode", "status", "prepared_at", "issue_signature", "signal_ids", "candidate_directory", "baseline_fingerprint", "initial_candidate_fingerprint", "allowed_paths", "active_writes", "provider_calls", "host_writes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "skill_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "candidate_mode": { "type": "string", "enum": ["existing", "new"] },
    "status": { "type": "string", "const": "prepared" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "issue_signature": { "type": "string", "minLength": 1 },
    "signal_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "candidate_directory": { "type": "string", "minLength": 1 },
    "baseline_fingerprint": { "$ref": "#/$defs/sha256" },
    "initial_candidate_fingerprint": { "$ref": "#/$defs/sha256" },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "active_writes": { "type": "integer", "const": 0 },
    "provider_calls": { "type": "integer", "const": 0 },
    "host_writes": { "type": "integer", "const": 0 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
