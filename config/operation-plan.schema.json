{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/operation-plan.v1.json",
  "title": "skills-manager OperationPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "domain", "mode", "created_at", "source_revision", "targets", "actions", "preconditions", "verification", "rollback"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "enum": ["mcp", "skill_projection", "rules", "plugin", "skill_lifecycle"] },
    "mode": { "type": "string", "enum": ["dry_run", "apply"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_revision": { "type": ["string", "null"] },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "preconditions": { "type": "array" },
    "verification": { "type": "array" },
    "rollback": { "type": "array" },
    "lifecycle": { "$ref": "#/$defs/skillLifecycle" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "path", "before_hash", "desired_hash", "owner"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "before_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "desired_hash": { "$ref": "#/$defs/sha256" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "type", "target_ref", "summary", "risk"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^act-[a-f0-9]{16}$" },
        "type": { "type": "string", "enum": ["create", "update", "delete", "native_command"] },
        "target_ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "metadata": { "type": "object" }
      }
    },
    "skillLifecycle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill_name", "candidate_directory", "candidate_fingerprint", "baseline_fingerprint", "catalog_fingerprint", "evaluation_path", "evaluation_hash", "review_path", "review_hash", "review_expires_at", "allowed_paths", "projection_disposition", "host_mutation"],
      "properties": {
        "skill_name": { "type": "string", "minLength": 1 },
        "candidate_directory": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "$ref": "#/$defs/sha256" },
        "baseline_fingerprint": { "$ref": "#/$defs/sha256" },
        "catalog_fingerprint": { "$ref": "#/$defs/sha256" },
        "evaluation_path": { "type": "string", "minLength": 1 },
        "evaluation_hash": { "$ref": "#/$defs/sha256" },
        "review_path": { "type": "string", "minLength": 1 },
        "review_hash": { "$ref": "#/$defs/sha256" },
        "review_expires_at": { "type": "string", "format": "date-time" },
        "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "projection_disposition": { "type": "string", "const": "cold_catalog_only" },
        "host_mutation": { "type": "boolean", "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "domain": { "const": "skill_lifecycle" } }, "required": ["domain"] },
      "then": { "required": ["lifecycle"] }
    }
  ],
  "x-secret-policy": "Sensitive values are redacted during object construction; validators fail closed when known secret forms remain."
}
