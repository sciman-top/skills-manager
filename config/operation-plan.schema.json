{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/operation-plan.v1.json",
  "title": "skills-manager OperationPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "domain", "mode", "created_at", "source_revision", "targets", "actions", "preconditions", "verification", "rollback"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "enum": ["mcp", "skill_projection", "rules", "plugin"] },
    "mode": { "type": "string", "enum": ["dry_run", "apply"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_revision": { "type": ["string", "null"] },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "preconditions": { "type": "array" },
    "verification": { "type": "array" },
    "rollback": { "type": "array" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "path", "before_hash", "desired_hash", "owner"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "before_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "desired_hash": { "$ref": "#/$defs/sha256" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "type", "target_ref", "summary", "risk"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^act-[a-f0-9]{16}$" },
        "type": { "type": "string", "enum": ["create", "update", "delete", "native_command"] },
        "target_ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "metadata": { "type": "object" }
      }
    }
  },
  "x-secret-policy": "Sensitive values are redacted during object construction; validators fail closed when known secret forms remain."
}
