{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/skills.v3.json",
  "title": "skills-manager configuration",
  "description": "Versioned structural contract for skills.json. Runtime semantic invariants remain authoritative in src/Config.ps1. Schema v3 seals the top level to the managed allowlist; v1/v2 remain runtime-readable for migration only.",
  "type": "object",
  "required": ["vendors", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "sync_mode": { "type": "string", "enum": ["link", "sync"], "default": "link" },
    "update_force": { "type": "boolean", "default": true },
    "vendors": { "type": "array", "items": { "$ref": "#/$defs/vendor" } },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" }, "default": [] },
    "imports": { "type": "array", "items": { "$ref": "#/$defs/import" }, "default": [] },
    "mcp_servers": { "type": "array", "items": { "$ref": "#/$defs/mcpServer" }, "default": [] },
    "mcp_targets": {
      "type": "array",
      "items": { "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/target" }] },
      "default": []
    },
    "mcp_profiles": { "$ref": "#/$defs/mcpProfiles" },
    "skill_projection": { "$ref": "#/$defs/skillProjection" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "vendor": {
      "type": "object",
      "required": ["name", "repo"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "repo": { "$ref": "#/$defs/nonEmptyString" },
        "ref": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "host": { "type": "string", "enum": ["codex", "claude", "zcode"] },
        "managed_link_only": { "type": "boolean" },
        "receipt_path": { "type": "string", "pattern": "^reports[\\\\/]skill-projection[\\\\/][^\\\\/]+\\.json$" }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["vendor", "from", "to"],
      "additionalProperties": true,
      "properties": {
        "vendor": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/nonEmptyString" },
        "to": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "import": {
      "type": "object",
      "required": ["name", "repo"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "repo": { "$ref": "#/$defs/nonEmptyString" },
        "ref": { "type": "string" },
        "skill": { "type": "string", "default": "." },
        "mode": { "type": "string", "enum": ["manual", "vendor"] },
        "sparse": { "type": "boolean" }
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "enabled": { "type": "boolean" },
        "transport": { "type": "string", "enum": ["stdio", "http"], "default": "stdio" },
        "command": { "type": "string" },
        "args": { "$ref": "#/$defs/stringArray" },
        "url": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "bearer_token_env_var": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "enabled_tools": { "$ref": "#/$defs/stringArray" },
        "startup_timeout_sec": { "type": "integer", "minimum": 1 }
      },
      "allOf": [{
        "if": { "properties": { "transport": { "const": "http" } }, "required": ["transport"] },
        "then": { "required": ["url"] },
        "else": { "required": ["command"] }
      }]
    },
    "mcpProfiles": {
      "type": "object",
      "required": ["active", "profiles"],
      "additionalProperties": true,
      "properties": {
        "active": { "$ref": "#/$defs/nonEmptyString" },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": true,
            "properties": {
              "enabled": { "$ref": "#/$defs/stringArray" },
              "enabled_tools": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringArray" } }
            }
          }
        }
      }
    },
    "skillProjection": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "codex_config_path": { "type": "string" },
        "manifest_path": { "type": "string" },
        "managed_source_path": { "type": "string" },
        "user_skill_root": { "type": "string" },
        "native_projection": { "$ref": "#/$defs/nativeProjection" },
        "native_agent_bridge": { "$ref": "#/$defs/nativeAgentBridge" },
        "managed_link_includes": { "$ref": "#/$defs/stringArray" },
        "managed_link_excludes": { "$ref": "#/$defs/stringArray" },
        "projection_profiles": { "$ref": "#/$defs/projectionProfiles" },
        "external_skill_inventory": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": true,
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "path": { "$ref": "#/$defs/nonEmptyString" },
              "priority": { "type": "integer" },
              "platforms": { "$ref": "#/$defs/stringArray" }
            }
          }
        }
      }
    },
    "projectionProfiles": {
      "type": "object",
      "required": ["schema_version", "default_profile", "profiles"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "default_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/projectionProfile" }
        },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codex": { "$ref": "#/$defs/projectionHost" },
            "claude": { "$ref": "#/$defs/projectionHost" },
            "zcode": { "$ref": "#/$defs/projectionHost" }
          }
        }
      }
    },
    "projectionProfile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_all": { "type": "boolean" },
        "include": { "$ref": "#/$defs/stringArray" },
        "exclude": { "$ref": "#/$defs/stringArray" }
      }
    },
    "projectionHost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "exclude": { "$ref": "#/$defs/stringArray" }
      }
    },
    "nativeProjection": {
      "type": "object",
      "required": ["enabled", "owner", "target_root", "receipt_path"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "enabled": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "target_root": { "$ref": "#/$defs/nonEmptyString" },
        "receipt_path": { "type": "string", "pattern": "^reports[\\\\/]skill-projection[\\\\/][^\\\\/]+\\.json$" }
      }
    },
    "nativeAgentBridge": {
      "type": "object",
      "required": ["enabled", "owner", "source_root", "target_root", "receipt_path", "definitions"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "source_root": { "type": "string", "pattern": "^agent[\\\\/]" },
        "target_root": { "const": "~/.codex/agents" },
        "receipt_path": { "type": "string", "pattern": "^reports[\\\\/]native-agent-bridge[\\\\/][^\\\\/]+\\.json$" },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    }
  },
  "x-compatibility-policy": {
    "missing_schema_version": "legacy-v1-observation",
    "declared_schema_v1": "runtime-read-migration-only",
    "declared_schema_v2": "runtime-read-migration-only",
    "legacy_sse": "schema-v1-read-only-deprecated",
    "unknown_properties": "v3-fail-closed"
  },
  "x-secret-policy": {
    "schema_examples_must_not_contain_values": true,
    "validator_output": "code-path-message-only",
    "host_auth_provider_model_context_sandbox_rules_plugins": "out-of-scope"
  }
}
