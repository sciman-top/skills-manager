{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/skill-evolution-decision.v1.json",
  "title": "SkillEvolution reviewed decision v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "decision_id", "request_id", "request_path", "request_hash", "review_type", "action", "skill_name", "subject_fingerprint", "reviewer", "decision", "reviewed_at", "expires_at", "authorization_token"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "request_path": { "type": "string", "minLength": 1 },
    "request_hash": { "$ref": "#/$defs/sha256" },
    "review_type": { "type": "string", "enum": ["promotion", "activation"] },
    "action": { "type": "string", "enum": ["promote", "enable", "refresh", "retire"] },
    "skill_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "subject_fingerprint": { "$ref": "#/$defs/sha256" },
    "reviewer": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["approve", "reject", "reject_delete"] },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "authorization_token": { "type": "string", "minLength": 1 },
    "cleanup_not_before": { "type": ["string", "null"], "format": "date-time" },
    "disposition": { "type": "string", "enum": ["approved_exact_current", "package_remains_cold", "candidate_delete_authorized", "candidate_retained"] },
    "candidate_directory": { "type": ["string", "null"] },
    "candidate_fingerprint": { "$ref": "#/$defs/sha256" },
    "baseline_fingerprint": { "$ref": "#/$defs/sha256" },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evaluation_receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "review_type": { "const": "promotion" }, "decision": { "const": "approve" } }, "required": ["review_type", "decision"] },
      "then": { "required": ["candidate_fingerprint", "baseline_fingerprint", "allowed_paths", "evaluation_receipt_hash"] }
    },
    {
      "if": { "properties": { "review_type": { "const": "activation" } }, "required": ["review_type"] },
      "then": { "properties": { "decision": { "enum": ["approve", "reject"] }, "candidate_directory": { "type": "null" } } }
    }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
