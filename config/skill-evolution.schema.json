{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/skill-evolution-review.v1.json",
  "title": "SkillEvolution reviewed change-set v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["candidate_fingerprint", "baseline_fingerprint", "allowed_paths", "reviewer", "decision", "reviewed_at", "expires_at", "evaluation_receipt_hash"],
  "properties": {
    "candidate_fingerprint": { "$ref": "#/$defs/sha256" },
    "baseline_fingerprint": { "$ref": "#/$defs/sha256" },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "reviewer": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "const": "approve" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evaluation_receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
