{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-manager.local/schema/skill-evolution-review-request.v1.json",
  "title": "SkillEvolution host review request v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "request_id", "review_type", "action", "status", "created_at", "expires_at", "skill_name", "subject_path", "subject_fingerprint", "baseline_fingerprint", "catalog_fingerprint", "allowed_paths", "authorization_token", "proposed_effects", "excluded_effects", "interaction"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "review_type": { "type": "string", "enum": ["promotion", "activation"] },
    "action": { "type": "string", "enum": ["promote", "enable", "refresh", "retire"] },
    "status": { "type": "string", "const": "authorization_required" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "skill_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "subject_path": { "type": "string", "minLength": 1 },
    "subject_fingerprint": { "$ref": "#/$defs/sha256" },
    "baseline_fingerprint": { "$ref": "#/$defs/sha256" },
    "catalog_fingerprint": { "$ref": "#/$defs/sha256" },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "authorization_token": { "type": "string", "minLength": 1 },
    "projection_token": { "type": ["string", "null"] },
    "proposed_effects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "excluded_effects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "interaction": {
      "type": "object",
      "required": ["required", "kind", "notification_class", "preferred_surface", "user_action", "cli_is_host_internal", "host_must_pause", "question", "options", "default_decision", "approval_token", "rejection_token", "deletion_token", "host_resume_command"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "kind": { "type": "string", "const": "question" },
        "notification_class": { "type": "string", "const": "permission_and_question" },
        "preferred_surface": { "type": "string", "const": "chatgpt_desktop" },
        "user_action": { "type": "string", "minLength": 1 },
        "cli_is_host_internal": { "type": "boolean", "const": true },
        "host_must_pause": { "type": "boolean", "const": true },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "maxItems": 3 },
        "default_decision": { "type": "string", "const": "reject" },
        "approval_token": { "type": "string", "minLength": 1 },
        "rejection_token": { "type": "string", "minLength": 1 },
        "deletion_token": { "type": ["string", "null"] },
        "host_resume_command": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "review_type": { "const": "promotion" } }, "required": ["review_type"] },
      "then": {
        "properties": {
          "interaction": {
            "properties": {
              "options": { "minItems": 3, "maxItems": 3 },
              "rejection_token": { "const": "REJECT_SKILL_CANDIDATE" },
              "deletion_token": { "const": "DELETE_REJECTED_SKILL_CANDIDATE" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "review_type": { "const": "activation" } }, "required": ["review_type"] },
      "then": {
        "properties": {
          "interaction": {
            "properties": {
              "options": { "minItems": 2, "maxItems": 2 },
              "rejection_token": { "const": "REJECT_SKILL_ACTIVATION_CHANGE" },
              "deletion_token": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
