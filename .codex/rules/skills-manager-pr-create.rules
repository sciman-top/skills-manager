prefix_rule(
    pattern = ["gh", "pr", "create", "--repo", "sciman-top/skills-manager", "--base", "main"],
    decision = "allow",
    justification = "Standing project authorization permits PR creation after review when the target repository is sciman-top/skills-manager and the base is main.",
)

