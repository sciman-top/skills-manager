  "targets": [
    {
      "path": "~/.claude/skills"
    }
  ],
  "update_force": true,
  "mcp_servers": [
    {
      "name": "context7",
      "enabled": false,
      "enabled_tools": [
        "resolve-library-id",
        "query-docs"
      ],
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "startup_timeout_sec": 120
    },
    {
      "name": "github",
      "enabled": false,
      "enabled_tools": [
        "get_me",
        "get_file_contents",
        "search_code",
        "list_commits",
        "get_commit",
        "pull_request_read",
        "issue_read",
        "search_issues",
        "search_pull_requests"
      ],
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    {
      "name": "microsoft-learn",
      "enabled": true,
      "enabled_tools": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "microsoft_code_sample_search"
      ],
      "transport": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "startup_timeout_sec": 120
    },
    {
      "name": "openaiDeveloperDocs",
      "enabled": true,
      "enabled_tools": [
        "search_openai_docs",
        "fetch_openai_doc",
        "list_openai_docs"
      ],
      "transport": "http",
      "url": "https://developers.openai.com/mcp",
      "startup_timeout_sec": 120
    },
    {
      "name": "playwright",
      "enabled": false,
      "enabled_tools": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_fill_form",
        "browser_type",
        "browser_wait_for",
        "browser_take_screenshot",
        "browser_close"
      ],
      "transport": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated"
      ]
    },
    {
      "name": "filesystem",
      "enabled": false,
      "enabled_tools": [
        "read_text_file",
        "read_multiple_files",
        "list_directory",
        "directory_tree",
        "search_files",
        "get_file_info"
      ],
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\CODE"
      ]
    },
    {
      "name": "postgres",
      "enabled": false,
      "enabled_tools": [
        "query"
      ],
      "transport": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$conn = $env:POSTGRES_CONNECTION_STRING; if ([string]::IsNullOrWhiteSpace($conn)) { $conn = [Environment]::GetEnvironmentVariable(\"POSTGRES_CONNECTION_STRING\", \"User\") }; if ([string]::IsNullOrWhiteSpace($conn)) { $conn = [Environment]::GetEnvironmentVariable(\"POSTGRES_CONNECTION_STRING\", \"Machine\") }; if ([string]::IsNullOrWhiteSpace($conn)) { Write-Error \"POSTGRES_CONNECTION_STRING is required for postgres MCP.\"; exit 64 }; $env:POSTGRES_CONNECTION_STRING = $conn; npx -y @modelcontextprotocol/server-postgres $conn"
      ]
    },
    {
      "name": "codebase-memory-mcp",
      "enabled": false,
      "transport": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$exe = Join-Path $env:LOCALAPPDATA 'Programs\\codebase-memory-mcp\\codebase-memory-mcp.exe'; if (-not (Test-Path -LiteralPath $exe)) { $cmd = Get-Command codebase-memory-mcp -ErrorAction SilentlyContinue; if ($cmd) { $exe = [string]$cmd.Source } else { Write-Error 'codebase-memory-mcp.exe not found. Run the official installer first.'; exit 64 } }; & $exe"
      ]
    }
  ],
  "mcp_profiles": {
    "active": "default",
    "profiles": {
      "default": {
        "enabled": [
          "microsoft-learn",
          "openaiDeveloperDocs"
        ],
        "enabled_tools": {
          "microsoft-learn": [
            "microsoft_docs_search",
            "microsoft_docs_fetch",
            "microsoft_code_sample_search"
          ],
          "openaiDeveloperDocs": [
            "search_openai_docs",
            "fetch_openai_doc"
          ]
        }
      },
      "coding": {
        "enabled": [
          "context7",
          "openaiDeveloperDocs"
        ]
      },
      "github": {
        "enabled": [
          "github"
        ]
      },
      "codebase": {
        "enabled": [
          "codebase-memory-mcp"
        ]
      },
      "dotnet": {
        "enabled": [
          "microsoft-learn",
          "openaiDeveloperDocs"
        ]
      },
      "browser": {
        "enabled": [
          "playwright"
        ]
      },
      "database": {
        "enabled": [
          "postgres"
        ]
      },
      "off": {
        "enabled": []
      }
    }
  },
  "mcp_targets": []
