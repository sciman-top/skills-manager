{
  "schema_version": 3,
  "sync_mode": "link",
  "skill_projection": {
    "enabled": true,
    "codex_config_path": "~/.codex/config.toml",
    "manifest_path": "reports/skill-projection/current.json",
    "managed_source_path": "agent",
    "user_skill_root": "~/.agents/skills",
    "projection_profiles": {
      "schema_version": 1,
      "default_profile": "core-lean",
      "profiles": {
        "core-lean": {
          "include": [
            "ai-coding-workflow",
            "capability-router",
            "code-review-and-quality",
            "custom-powershell-windows-automation",
            "research",
            "systematic-debugging",
            "verification-before-completion"
          ],
          "exclude": []
        },
        "core-ops": {
          "include": [
            "ai-coding-workflow",
            "capability-router",
            "code-review-and-quality",
            "custom-powershell-windows-automation",
            "research",
            "sandbox-slow-test-diagnosis",
            "systematic-debugging",
            "verification-before-completion"
          ],
          "exclude": []
        },
        "design-interview": {
          "include": [
            "grilling",
            "domain-modeling"
          ],
          "exclude": []
        },
        "full-compatible": {
          "include_all": true,
          "exclude": []
        }
      },
      "hosts": {
        "codex": {
          "default_profile": "core-lean",
          "exclude": [
            "docx",
            "pptx",
            "skill-creator",
            "xlsx"
          ]
        },
        "claude": {
          "default_profile": "core-lean",
          "exclude": []
        },
        "zcode": {
          "default_profile": "core-lean",
          "exclude": [
            "agent-browser",
            "docx",
            "pptx",
            "skill-creator",
            "xlsx"
          ]
        },
        "antigravity": {
          "default_profile": "core-lean",
          "exclude": [
            "docx",
            "pptx",
            "skill-creator",
            "xlsx"
          ]
        },
        "workbuddy": {
          "default_profile": "core-ops",
          "exclude": []
        },
        "dsh": {
          "default_profile": "core-lean",
          "exclude": [
            "docx",
            "pptx",
            "skill-creator",
            "xlsx"
          ]
        }
      }
    },
    "external_skill_inventory": {
      "enabled": true
    },
    "native_projection": {
      "schema_version": 1,
      "enabled": true,
      "owner": "skills-manager",
      "target_root": "~/.agents/skills",
      "receipt_path": "reports/skill-projection/native-receipt.json"
    },
    "native_agent_bridge": {
      "enabled": true,
      "owner": "skills-manager",
      "source_root": "agent/native-agent-bridge",
      "target_root": "~/.codex/agents",
      "receipt_path": "reports/native-agent-bridge/current.json",
      "definitions": [
        "design-griller",
        "cold-capability-runner"
      ]
    },
    "claude_native_agent_bridge": {
      "enabled": true,
      "owner": "skills-manager",
      "source_root": "agent/native-agent-bridge/claude",
      "target_root": "~/.claude/agents",
      "receipt_path": "reports/native-agent-bridge/claude-current.json",
      "definitions": [
        "design-griller",
        "cold-capability-runner"
      ]
    },
    "discovery_catalog": {
      "catalog_path": "agent/.skills-manager/catalog.json",
      "fallback_domain": "other",
      "fallback_purpose": "Unclassified cold skills. Do not rely on bounded implicit discovery until a narrower functional domain is assigned.",
      "side_effects": {
        "domain-modeling": "controlled_write",
        "grilling": "read_only"
      },
      "execution_contracts": {
        "domain-modeling": {
          "mode": "one_shot",
          "native_agent": "cold-capability-runner",
          "conversation_owner": "runner",
          "stop_condition": "parent_contract"
        },
        "grilling": {
          "mode": "multi_turn_user_decision",
          "native_agent": "design-griller",
          "conversation_owner": "parent",
          "stop_condition": "one_question_then_wait"
        }
      },
      "domain_memberships": {
        "browser": [
          "agent-browser",
          "webapp-testing",
          "research"
        ],
        "engineering": [
          "architecture-patterns",
          "codebase-design",
          "context-engineering",
          "documentation-and-adrs",
          "domain-modeling",
          "draft-spec",
          "idea-refine"
        ],
        "content": [
          "docx",
          "pdf",
          "xlsx"
        ],
        "coding": [
          "ai-coding-workflow",
          "api-and-interface-design",
          "code-simplification",
          "code-review-and-quality",
          "custom-powershell-windows-automation",
          "deprecation-and-migration",
          "error-handling-patterns",
          "sandbox-slow-test-diagnosis",
          "security-and-hardening",
          "shipping-and-launch",
          "systematic-debugging",
          "verification-before-completion"
        ],
        "coding-strict": [
          "systematic-debugging",
          "test-driven-development"
        ],
        "general": [
          "systematic-debugging",
          "verification-before-completion"
        ],
        "design": [
          "canvas-design",
          "data-visualization",
          "frontend-design"
        ],
        "dotnet": [
          "custom-windows-wpf-teacher-app",
          "dotnet-backend-patterns",
          "microsoft-code-reference",
          "microsoft-docs",
          "systematic-debugging",
          "windows-desktop-e2e"
        ],
        "ppt": [
          "custom-powerpoint-accessibility",
          "pptx"
        ],
        "review": [
          "code-review-and-quality",
          "security-and-hardening"
        ],
        "python": [
          "systematic-debugging"
        ],
        "database": [
          "security-and-hardening"
        ],
        "physics": [
          "custom-junior-physics-animation"
        ],
        "animation": [
          "custom-junior-physics-animation",
          "manim-composer"
        ],
        "decision": [
          "documentation-and-adrs",
          "domain-modeling",
          "draft-spec",
          "grilling",
          "idea-refine"
        ],
        "diagram": [
          "data-visualization",
          "drawio-diagram-forge"
        ],
        "frontend": [
          "frontend-design"
        ],
        "mcp": [
          "mcp-builder",
          "mcp-cli"
        ],
        "presentation": [
          "custom-powerpoint-accessibility",
          "custom-teacher-courseware-ppt",
          "pptx"
        ],
        "skill-management": [
          "capability-router",
          "skill-creator"
        ]
      }
    },
    "sources": [
      {
        "id": "agents-user",
        "path": "~/.agents/skills",
        "priority": 200,
        "platforms": [
          "codex"
        ]
      }
    ]
  },
  "vendors": [
