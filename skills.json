  "targets": [
    {
      "path": "~/.claude/skills",
      "host": "claude",
      "managed_link_only": true,
      "receipt_path": "reports/skill-projection/claude-native-receipt.json"
    },
    {
      "path": "~/.zcode/skills",
      "host": "zcode",
      "managed_link_only": true,
      "receipt_path": "reports/skill-projection/zcode-native-receipt.json"
    },
    {
      "path": "~/.gemini/config/skills",
      "host": "antigravity",
      "managed_link_only": true,
      "receipt_path": "reports/skill-projection/antigravity-native-receipt.json"
    },
    {
      "path": "~/.workbuddy-ai/skills",
      "host": "workbuddy",
      "managed_link_only": true,
      "receipt_path": "reports/skill-projection/workbuddy-native-receipt.json"
    },
    {
      "path": "~/.workbuddy/skills",
      "host": "workbuddy",
      "managed_link_only": true,
      "receipt_path": "reports/skill-projection/workbuddy-cn-native-receipt.json"
    }
  ],
  "update_force": true,
  "mcp_servers": [
    {
      "name": "context7",
      "enabled_tools": [
        "resolve-library-id",
        "query-docs"
      ],
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.2.3"
      ],
      "startup_timeout_sec": 120
    },
    {
      "name": "microsoft-learn",
      "enabled_tools": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "microsoft_code_sample_search"
      ],
      "transport": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "startup_timeout_sec": 120
    },
    {
      "name": "openaiDeveloperDocs",
      "enabled_tools": [
        "search_openai_docs",
        "fetch_openai_doc",
        "list_openai_docs"
      ],
      "transport": "http",
      "url": "https://developers.openai.com/mcp",
      "startup_timeout_sec": 120
    },
    {
      "name": "playwright",
      "enabled_tools": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_fill_form",
        "browser_type",
        "browser_wait_for",
        "browser_take_screenshot",
        "browser_close"
      ],
      "transport": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.78",
        "--isolated"
      ]
    }
  ],
  "mcp_profiles": {
    "active": "default",
    "profiles": {
      "default": {
        "enabled": []
      },
      "coding": {
        "enabled": [
          "openaiDeveloperDocs"
        ],
        "enabled_tools": {
          "openaiDeveloperDocs": [
            "search_openai_docs",
            "fetch_openai_doc"
          ]
        }
      },
      "dotnet": {
        "enabled": [
          "microsoft-learn"
        ],
        "enabled_tools": {
          "microsoft-learn": [
            "microsoft_docs_search",
            "microsoft_docs_fetch",
            "microsoft_code_sample_search"
          ]
        }
      },
      "browser": {
        "enabled": [
          "playwright"
        ]
      },
      "database": {
        "enabled": []
      },
      "off": {
        "enabled": []
      }
    }
  },
  "mcp_targets": [
    "~/.codex"
  ]
}
