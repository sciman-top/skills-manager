{
  "schema_version": 3,
  "sync_mode": "link",
  "skill_projection": {
    "enabled": true,
    "codex_config_path": "~/.codex/config.toml",
    "manifest_path": "reports/skill-projection/current.json",
    "managed_source_path": "agent",
    "user_skill_root": "~/.agents/skills",
    "managed_link_includes": [
      "capability-router",
      "code-review-and-quality",
      "custom-powershell-windows-automation",
      "research",
      "systematic-debugging",
      "verification-before-completion"
    ],
    "managed_link_excludes": [
      "skill-creator"
    ],
    "projection_profiles": {
      "schema_version": 1,
      "default_profile": "core-lean",
      "profiles": {
        "core-lean": {
          "include": [
            "capability-router",
            "code-review-and-quality",
            "custom-powershell-windows-automation",
            "research",
            "systematic-debugging",
            "verification-before-completion"
          ],
          "exclude": []
        },
        "core": {
          "include": [
            "capability-router",
            "codebase-design",
            "code-review-and-quality",
            "custom-powerpoint-accessibility",
            "custom-powershell-windows-automation",
            "grill-me",
            "research",
            "systematic-debugging",
            "verification-before-completion"
          ],
          "exclude": []
        },
        "design": {
          "include": [
            "grill-me",
            "grilling",
            "grill-with-docs",
            "domain-modeling"
          ],
          "exclude": []
        },
        "full-compatible": {
          "include_all": true,
          "exclude": []
        }
      },
      "hosts": {
        "codex": {
          "default_profile": "core-lean",
          "exclude": [
            "docx",
            "pptx",
            "skill-creator",
            "web-artifacts-builder",
            "xlsx"
          ]
        },
        "claude": {
          "default_profile": "core-lean",
          "exclude": []
        },
        "zcode": {
          "default_profile": "core-lean",
          "exclude": [
            "agent-browser",
            "skill-creator",
            "web-artifacts-builder"
          ]
        }
      }
    },
    "external_skill_inventory": {
      "enabled": true
    },
    "native_projection": {
      "schema_version": 1,
      "enabled": true,
      "owner": "skills-manager",
      "target_root": "~/.agents/skills",
      "receipt_path": "reports/skill-projection/native-receipt.json"
    },
    "native_agent_bridge": {
      "enabled": true,
      "owner": "skills-manager",
      "source_root": "agent/native-agent-bridge",
      "target_root": "~/.codex/agents",
      "receipt_path": "reports/native-agent-bridge/current.json",
      "definitions": [
        "design-griller",
        "cold-capability-runner"
      ]
    },
    "discovery_catalog": {
      "catalog_path": "agent/.skills-manager/catalog.json",
      "fallback_domain": "other",
      "fallback_purpose": "Unclassified cold skills. Do not rely on bounded implicit discovery until a narrower functional domain is assigned.",
      "side_effects": {
        "domain-modeling": "controlled_write",
        "grill-with-docs": "controlled_write",
        "grilling": "read_only"
      },
      "execution_contracts": {
        "domain-modeling": {
          "mode": "one_shot",
          "native_agent": "cold-capability-runner",
          "conversation_owner": "runner",
          "stop_condition": "parent_contract"
        },
        "grill-with-docs": {
          "mode": "multi_turn_user_decision",
          "native_agent": "design-griller",
          "conversation_owner": "parent",
          "stop_condition": "one_question_then_wait"
        },
        "grilling": {
          "mode": "multi_turn_user_decision",
          "native_agent": "design-griller",
          "conversation_owner": "parent",
          "stop_condition": "one_question_then_wait"
        }
      },
      "domain_memberships": {
        "browser": [
          "agent-browser",
          "playwright-best-practices",
          "webapp-testing",
          "research"
        ],
        "engineering": [
          "architecture-patterns",
          "codebase-design",
          "context-engineering",
          "documentation-and-adrs",
          "domain-modeling",
          "draft-spec",
          "draft-tickets",
          "idea-refine",
