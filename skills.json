          "powerpoint-automation",
          "pptx",
          "slidev"
        ],
        "skill-management": [
          "capability-router",
          "skill-creator"
        ],
        "writing": [
          "baoyu-format-markdown",
          "content-strategy",
          "copy-editing",
          "copywriting",
          "custom-creator-publishing"
        ]
      }
    },
    "sources": [
      {
        "id": "agents-user",
        "path": "~/.agents/skills",
        "priority": 200,
        "platforms": [
          "codex"
        ]
      }
